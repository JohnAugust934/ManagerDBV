APP_NAME=Laravel
# APP_VERSION=v2026_5.0.0   # opcional: sobrescreve a versão exibida (default em config/app.php)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_MONITOR_ENABLED=true
QUEUE_MONITOR_QUEUE=default
QUEUE_MONITOR_MAX_SIZE=50
QUEUE_MONITOR_PAUSE_WINDOWS=02:45-04:45

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BACKUP_NOTIFICATIONS_MAIL_TO=
BACKUP_DESTINATION_DISKS=local,r2
BACKUP_MONITOR_DISKS=local,r2
BACKUP_VERIFY=true
# Criptografia do zip DESLIGADA: a libzip da hospedagem (Hostinger/PHP 8.4) nao
# suporta AES e quebra o ZipArchive::close(). So habilite num host compativel.
BACKUP_ARCHIVE_ENCRYPTION_ENABLED=false
BACKUP_ARCHIVE_ENCRYPTION=default
BACKUP_MONITOR_MAX_AGE_DAYS=1
BACKUP_MONITOR_MAX_STORAGE_MB=5000
# Retencao (rotacao feita pelo backup:clean do spatie, agendado 04:00).
# BACKUP_RETENTION_DAYS = knob principal: mantem todos os backups dos ultimos N
# dias. Em DEV usamos um valor curto para testes. As regras granulares abaixo
# (0 = desligado) permitem reter historico de longo prazo sem acumular tudo, e
# BACKUP_MAX_STORAGE_MB apaga os mais antigos quando o total estoura o teto.
BACKUP_RETENTION_DAYS=7
# BACKUP_KEEP_ALL_DAYS=    # override avancado: prevalece sobre RETENTION_DAYS
BACKUP_KEEP_DAILY_DAYS=0
BACKUP_KEEP_WEEKLY_WEEKS=0
BACKUP_KEEP_MONTHLY_MONTHS=0
BACKUP_KEEP_YEARLY_YEARS=0
BACKUP_MAX_STORAGE_MB=5000
# Quantos dias manter o HISTORICO em backup_logs (barato, so metadados/checksums).
BACKUP_LOG_RETENTION_DAYS=365
# Verificacao de integridade propria pos-backup (tamanho, reabertura do zip,
# presenca do dump+uploads, checksum + manifest.json). Falha = alerta imediato.
BACKUP_INTEGRITY_CHECK_ENABLED=true
BACKUP_MIN_SIZE_KB=50
BACKUP_SLACK_WEBHOOK_URL=
BACKUP_SLACK_CHANNEL=
BACKUP_SLACK_USERNAME=
BACKUP_SLACK_ICON=
BACKUP_DISCORD_WEBHOOK_URL=
BACKUP_DISCORD_USERNAME=
BACKUP_DISCORD_AVATAR_URL=
BACKUP_WEBHOOK_URL=
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_TIMEOUT=10
TELEGRAM_ADMIN_NOTIFICATIONS=true
TELEGRAM_ERROR_NOTIFICATIONS=true
TELEGRAM_ERROR_DEDUP_SECONDS=300
TELEGRAM_SUPPRESS_TRANSIENT_DB_ERRORS=true
TELEGRAM_TRANSIENT_DB_SUPPRESS_WINDOWS=02:45-04:45


R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

VITE_APP_NAME="${APP_NAME}"
